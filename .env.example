# Wield contracts — Robinhood Chain Mainnet (chainId 4663)
# Copy to .env and fill in. NEVER commit .env.

# --- Network ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPECTED_CHAIN_ID=4663

# --- Signer ---
# Deployer key. Use a dedicated deploy key, not a personal wallet.
DEPLOYER_PRIVATE_KEY=

# --- Core addresses ---
# USDG (Paxos) — settlement asset for every vault.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Address allowed to submit signed rebalance intents.
AGENT_DID_ADDRESS=
# Same role as AGENT_DID_ADDRESS, used by DeployBaskets.
KEEPER_ADDRESS=

# --- Uniswap V3 (SwapRouter02) ---
DEX_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2

# --- Deploy.s.sol / DeployAll.s.sol: yield-bearing underlyings (ERC-4626) ---
UNDERLYING_1=
UNDERLYING_2=

# --- DeployBaskets.s.sol: tokenized equities ---
AAPL=0xaf3d76f1834a1d425780943c99ea8a608f8a93f9
GOOGL=0x2e0847e8910a9732eb3fb1bb4b70a580adad4fe3
USO=0xa30fa36db767ad9ed3f7a60fc79526fb4d56d344
SPCX=0x4a0e65a3eccec6dbe60ae065f2e7bb85fae35eea

# --- DeployBaskets.s.sol: Chainlink feeds (all 8 decimals) ---
# NOTE: Robinhood tokenized-equity feeds already include the split multiplier.
# Do NOT multiply the answer again. See docs.chain.link/data-feeds/tokenized-equity-feeds/robinhood
AAPL_FEED=0x6B22A786bAa607d76728168703a39Ea9C99f2cD0
GOOGL_FEED=0xF6f373a037c30F0e5010d854385cA89185AE638b
USO_FEED=0x75a9c76Ef439e2C7c2E5a34Ab105EcFe3766431c
SPCX_FEED=0xB265810950ba6c5C0Ff821c9963014a56fD8Bffb

# --- Seed deposit (anti first-depositor inflation) ---
# USDG amount (6 decimals) deposited into each basket vault at deploy time and
# never withdrawn. Set to 0 to skip; OZ v5 ERC4626 virtual shares still apply.
SEED_USDG=0
